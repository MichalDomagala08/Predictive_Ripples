# MATLAB temporary and autogenerated files
*.asv            # Auto-saved variable files (MATLAB)
*.autosave       # autosave files
*.m~             # backup files ending with ~
*~               # editor backups
*.mat            # (opcjonalne) dane binarne MATLAB — odkomentuj jeśli chcesz ignorować wszystkie .mat
*.fig            # (opcjonalne) pliki figure — odkomentuj jeśli chcesz ignorować
*.mex*           # compiled mex files
*.p              # protected files
*.slxc           # Simulink compiled
*.slx            # jeśli chcesz ignorować pliki modeli Simulink, odkomentuj
*.mdl            # starszy format Simulink

# Other (Fieldtirp and Freesurfer)
*.nii         
*.jpg				
*.png

# Folders to ignore
preprocessed/**/*.mat
data/**/*.mat
data/**/*.FSAVERAGE
data/**/*.jpeg
data/**/*.jpg
results/**/*.ps
results/**/*.png
results/**/*.pdf

data/freeview_photos_freesurfer/
toolboxes/


# Folder structure handling
!**/.gitkeep
